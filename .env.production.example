# Template for the SERVER environment. Copy to the host's secret store / .env there. Never commit real values.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=generate-a-unique-50+-character-random-value
ALLOWED_HOSTS=mehrcoolrefrigeration.co.uk,www.mehrcoolrefrigeration.co.uk
CSRF_TRUSTED_ORIGINS=https://mehrcoolrefrigeration.co.uk,https://www.mehrcoolrefrigeration.co.uk
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# Transactional provider (Mailgun/Postmark/SES...) with SPF, DKIM and DMARC on mehrcoolrefrigeration.co.uk
EMAIL_URL=smtp+tls://USER:PASSWORD@smtp.provider.example:587
DEFAULT_FROM_EMAIL=Mehr Cool Website <noreply@mehrcoolrefrigeration.co.uk>
LEAD_NOTIFICATION_EMAIL=info@mehrcoolrefrigeration.co.uk
SITE_URL=https://mehrcoolrefrigeration.co.uk
