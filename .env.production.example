# Template for the SERVER environment. Copy to /opt/vps_data/Bank/.env.production. Never commit real values.
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
SECRET_KEY=generate-a-unique-50+-character-random-value
ALLOWED_HOSTS=mehrcoolrefrigeration.co.uk,www.mehrcoolrefrigeration.co.uk
CSRF_TRUSTED_ORIGINS=https://mehrcoolrefrigeration.co.uk,https://www.mehrcoolrefrigeration.co.uk
SITE_URL=https://mehrcoolrefrigeration.co.uk
# Used by the db container and must match DATABASE_URL (use a hex/alphanumeric password, no URL-special chars)
POSTGRES_DB=mehrcool
POSTGRES_USER=mehrcool
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://mehrcool:change-me@db:5432/mehrcool
# URL-encode special characters (@ -> %40). Gmail needs an app password and a From address that is the account or a verified alias.
EMAIL_URL=smtp+tls://USER%40example.com:APP_PASSWORD@smtp.provider.example:587
DEFAULT_FROM_EMAIL=Mehr Cool Website <noreply@mehrcoolrefrigeration.co.uk>
LEAD_NOTIFICATION_EMAIL=info@mehrcoolrefrigeration.co.uk
EMERGENCY_PHONE_FALLBACK=+44 77 7888 9080
TRADING_NAME_FALLBACK=Mehr Cool Refrigeration & Air Conditioning
SECURE_HSTS_SECONDS=31536000
