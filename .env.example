# Copy to .env and fill in. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Local: sqlite. Production: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///db.sqlite3
# Email. Local default prints to console. Production example:
# EMAIL_URL=smtp+tls://user:password@smtp.eu.mailgun.org:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Mehr Cool Website <noreply@mehrcoolrefrigeration.co.uk>
# Where lead notifications are sent if Site settings in the admin leaves it blank.
LEAD_NOTIFICATION_EMAIL=info@mehrcoolrefrigeration.co.uk
# Canonical public origin used in sitemaps, canonical tags and JSON-LD.
SITE_URL=https://mehrcoolrefrigeration.co.uk
# Shown on the 500 error page if the database is unreachable
EMERGENCY_PHONE_FALLBACK=+44 77 7888 9080
TRADING_NAME_FALLBACK=Mehr Cool Refrigeration & Air Conditioning
# Set True locally to enable /styleguide/
STYLEGUIDE_ENABLED=True
# Production only
CSRF_TRUSTED_ORIGINS=https://mehrcoolrefrigeration.co.uk,https://www.mehrcoolrefrigeration.co.uk
SECURE_HSTS_SECONDS=31536000
